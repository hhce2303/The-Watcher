# Copy this file outside the repository as operator-deployment.env and replace
# every placeholder before building an external Operator installer.
#
# Keep the three files below next to this file using the relative paths shown.
# The build script stages them in the installer; no source repository, Python,
# or post-install configuration is needed on the Operator PC.

LIVE_VIEW_ENABLED=true
LIVE_VIEW_BIND_HOST=0.0.0.0
LIVE_VIEW_PORT=8767
LIVE_VIEW_ORIGIN=https://OPERATOR-PC-DNS:8767
LIVE_VIEW_PARENT_ORIGIN=https://daily.sig.systems
LIVE_VIEW_HEARTBEAT_URL=https://gbtmbuzlnxdjcexppomf.supabase.co/functions/v1/watcher-heartbeat
LIVE_VIEW_HEARTBEAT_SECONDS=30
LIVE_VIEW_MAX_VIEWERS=3
LIVE_VIEW_ISSUER=daily.sig.systems
LIVE_VIEW_AUDIENCE=the-watcher-live
LIVE_VIEW_ISSUER_KID=REPLACE_WITH_DAILY_SIGNING_KEY_ID
LIVE_VIEW_STATION_ID=REPLACE_WITH_STATION_ID
LIVE_VIEW_CERT_FILE=certs\live-view.pem
LIVE_VIEW_KEY_FILE=certs\live-view-key.pem
LIVE_VIEW_ISSUER_PUBLIC_KEY_FILE=certs\daily-issuer-public.pem

# Browser-local remains loopback-only. It is optional for an Operator-only
# external deployment and should not be used as the Supervisor LAN channel.
BROWSER_LOCAL_ENABLED=false
