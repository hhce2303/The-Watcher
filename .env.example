# The Watcher — Environment Configuration
# Copy this file to .env and adjust values for your machine.

# ── Directories ──────────────────────────────────────────────────────────────
# Use absolute paths OUTSIDE of OneDrive / synced folders to avoid
# Windows Defender / OneDrive holding locks on segment files.
#
# WatcherData\
#   segments\      ← rolling MPEG-TS buffer (auto-pruned, SEGMENT_DIR)
#   clips_raw\     ← individual per-monitor MP4s, one file per screen (RAW_CLIPS_DIR)
#   clips\         ← combined multi-monitor MP4 + timestamp overlay (CLIPS_DIR)
#   clips_events\  ← auto/manual event-triggered highlight clips (CLIPS_EVENTS_DIR)
#
#SEGMENT_DIR=C:\WatcherData\segments
# Final combined MP4s only. Raw clips and segments remain local paths above.
CLIPS_DIR=\\SIG-SLC-Storage\Storage3\Operator 29
#RAW_CLIPS_DIR=C:\WatcherData\clips_raw
#CLIPS_EVENTS_DIR=C:\WatcherData\clips_events

# ── Recording retention ───────────────────────────────────────────────────────
# RETENTION_HOURS — how many hours of raw segments to keep on disk (rolling buffer).
RETENTION_HOURS=8

# SEGMENT_DURATION — length of each raw MPEG-TS segment file in seconds.
# The clip builder assembles segments into clips; SEGMENT_DURATION controls
# how often a new segment file starts, which sets the minimum clip granularity.
#
# Rule of thumb: set SEGMENT_DURATION == CLIP_WINDOW_MINUTES * 60
# so each clip window contains exactly one segment.
#
#   ── Production (default) ──────────────────────────────────────────
SEGMENT_DURATION=300         # 5-minute segments
CLIP_WINDOW_MINUTES=60       # close and start a new clip every 60 minutes
CLIP_MAX_SIZE_MB=3072        # also close if clip would exceed 3 GB
#
#   ── Testing — uncomment to verify clip creation in ~1 minute ──────
#SEGMENT_DURATION=60         # 1-minute segments
#CLIP_WINDOW_MINUTES=1       # 1-minute clips — you'll see logs within seconds
#CLIP_MAX_SIZE_MB=50         # also test size-based overflow at 50 MB

# ── Capture ──────────────────────────────────────────────────────────────────
# "desktop" captures the full screen via gdigrab.
# To capture a specific window use its title, e.g.: CAPTURE_SOURCE=title=Chrome
CAPTURE_SOURCE=desktop
CAPTURE_FRAMERATE=30
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080

# CAPTURE_BACKEND — "auto" (prefer ddagrab/DXGI, fall back to gdigrab if
# unavailable), "ddagrab" (force DXGI Desktop Duplication), or "gdigrab"
# (force legacy GDI BitBlt).
CAPTURE_BACKEND=auto

# CAPTURE_PIPELINE — only matters when the backend is ddagrab. "auto" tries the
# zero-copy GPU filtergraph (hwmap->vpp_qsv on Intel, hwmap->CUDA on NVIDIA) and
# falls back to the legacy hwdownload path per monitor if the probe fails.
# "zerocopy" forces it (same per-monitor fallback safety net). "legacy" always
# downloads frames to system memory before scaling. Zero-copy measured ~66%
# less CPU/monitor on QSV — see
# docs/migration/ffmpeg-pipeline-optimization-research.md
CAPTURE_PIPELINE=auto

# CLIP_ENGINE (Track R2 M1) — "auto"/"rust": route the single-monitor clip path
# through the native Rust watcher_segments engine when it's the active segment
# compiler (ENGINE_READY-gated); "ffmpeg" forces the legacy FFmpeg concat/-c
# copy path. Any Rust exception falls back to FFmpeg regardless of this value.
CLIP_ENGINE=auto

# ── Encoding ─────────────────────────────────────────────────────────────────
# CRF / constant-quality: lower = better quality / larger files (0–51, default 28)
CRF=28

# VIDEO_CODEC — "hevc" (H.265, ~40–50% smaller at equal quality) or "h264".
# Applies to both the live recorder and offline clip assembly. If no HEVC
# encoder is available it falls back to H.264 automatically.
# In-app playback (Qt FFmpeg backend) supports HEVC; external players may need
# the Windows "HEVC Video Extensions". Use "h264" for fleets without HEVC.
VIDEO_CODEC=hevc

# â”€â”€ Daily SIG Systems â†” browser-local daemon channel â”€â”€
# Disabled by default. Enable only after the device has been enrolled in
# SIGDailyReport and the TLS provisioning service has issued the local
# certificate (see docs/architecture/tls-provisioning-contract.md). The adapter always listens only on 127.0.0.1 and ::1.
#BROWSER_LOCAL_ENABLED=false
#BROWSER_LOCAL_PARENT_ORIGIN=https://daily.sig.systems
#BROWSER_LOCAL_ISSUER=daily.sig.systems
#BROWSER_LOCAL_AUDIENCE=the-watcher-local
#BROWSER_LOCAL_ISSUER_KID=watcher-ed25519-2026-01
#BROWSER_LOCAL_STATION_ID=0
#BROWSER_LOCAL_CERT_FILE=C:\\Users\\<user>\\AppData\\Local\\The Watcher\\browser_local\\localhost.pem
#BROWSER_LOCAL_KEY_FILE=C:\\Users\\<user>\\AppData\\Local\\The Watcher\\browser_local\\localhost-key.pem
#BROWSER_LOCAL_ISSUER_PUBLIC_KEY_FILE=C:\\Users\\<user>\\AppData\\Local\\The Watcher\\browser_local\\daily-issuer-public.pem
#BROWSER_LOCAL_DATA_DIR=C:\\Users\\<user>\\AppData\\Local\\The Watcher\\browser_local

# ── Daily Supervisor LAN live view ──────────────────────────────────────────
# A separate TLS endpoint for remote supervisors. Do not point this at the
# loopback browser-local certificate or expose it outside the corporate LAN.
#LIVE_VIEW_ENABLED=false
#LIVE_VIEW_BIND_HOST=0.0.0.0
#LIVE_VIEW_PORT=8767
#LIVE_VIEW_ORIGIN=https://watcher-operator-01.corp.example:8767
#LIVE_VIEW_PARENT_ORIGIN=https://daily.sig.systems
#LIVE_VIEW_ISSUER=daily.sig.systems
#LIVE_VIEW_AUDIENCE=the-watcher-live
#LIVE_VIEW_ISSUER_KID=watcher-ed25519-2026-01
#LIVE_VIEW_STATION_ID=0
# TLS material source (ADR-0023). "file" (default) reads the *_FILE paths below.
# "remote" is reserved for the external provisioning service (not implemented yet).
#TLS_PROVISIONING_MODE=file
#LIVE_VIEW_CERT_FILE=C:\\ProgramData\\The Watcher\\live-view.pem
#LIVE_VIEW_KEY_FILE=C:\\ProgramData\\The Watcher\\live-view-key.pem
#LIVE_VIEW_ISSUER_PUBLIC_KEY_FILE=C:\\ProgramData\\The Watcher\\daily-issuer-public.pem
#LIVE_VIEW_HEARTBEAT_URL=https://<project>.supabase.co/functions/v1/watcher-heartbeat
#LIVE_VIEW_HEARTBEAT_SECONDS=30
#LIVE_VIEW_MAX_VIEWERS=3
# h264 (default): video codificado bajo demanda por un único WebSocket, con MJPEG
# automático de respaldo. mjpeg: fuerza el transporte JPEG anterior.
#LIVE_VIEW_TRANSPORT=h264
#LIVE_VIEW_VIDEO_FPS=24
#LIVE_VIEW_VIDEO_WIDTH=1280
#LIVE_VIEW_VIDEO_KBPS=3000

# ── Combined multi-monitor grid ───────────────────────────────────────────────
# The combined clip (clips/) packs every monitor into one grid for review and
# is re-encoded — its resolution is the dominant size driver. Per-monitor raw
# clips (clips_raw/) keep full OUTPUT_WIDTH/HEIGHT regardless.
# Each grid cell is scaled to COMBINED_CELL_WIDTH×HEIGHT (default 1280×720 →
# a 2×2 grid is 2560×1440 instead of 4K). COMBINED_QUALITY is the CRF/-cq/
# -global_quality target for the grid (higher = smaller).
COMBINED_CELL_WIDTH=1280
COMBINED_CELL_HEIGHT=720
COMBINED_QUALITY=27

# ── Reliability ──────────────────────────────────────────────────────────────
# MAX_RECORDER_RESTARTS — max consecutive FFmpeg crash-restarts before giving up.
MAX_RECORDER_RESTARTS=10
# DISK_WARN_BYTES / DISK_STOP_BYTES — free-disk-space thresholds in bytes.
# Default: warn at 2 GB free, stop recording at 512 MB free.
DISK_WARN_BYTES=2147483648
DISK_STOP_BYTES=536870912

# ── Batch FFmpeg governance (PoC-2) ───────────────────────────────────────────
# Governs offline/background FFmpeg work: hourly + combined clip builders, the
# mp4 converter, and the batch analyzer. Never applies to the live recorder.
# MAX_BATCH_FFMPEG — max batch encodes running at once system-wide (default 1).
MAX_BATCH_FFMPEG=1
# BATCH_JOB_WEIGHT — relative CPU share (1-9) batch gets when the recorder
# also needs the CPU (WEIGHT_BASED, not a hard cap — batch still finishes).
BATCH_JOB_WEIGHT=2
# BATCH_JOB_MEMORY_LIMIT_MB — hard RAM ceiling for all batch FFmpeg processes
# combined (0 = no limit).
BATCH_JOB_MEMORY_LIMIT_MB=1536
# BATCH_CPU_HARD_CAP_PERCENT — optional hard CPU ceiling for batch work only
# (0 = off, use BATCH_JOB_WEIGHT instead). A hard cap FREEZES threads once the
# interval budget is spent — fine for batch, never for the recorder.
BATCH_CPU_HARD_CAP_PERCENT=0
# PROC_TELEMETRY_INTERVAL_SECONDS — psutil sampling interval (CPU%/RSS) for
# tracked recorder/batch processes; feeds the ADR-0007 Rust-port gate.
PROC_TELEMETRY_INTERVAL_SECONDS=10

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Event-clip window (ClipBuilder) ───────────────────────────────────────────
# Seconds of footage before/after a trigger when an event clip is assembled.
#EVENT_POST_SECONDS=120
#EVENT_PRE_SECONDS=120
